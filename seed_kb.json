{
  "show me disk usage": "df -h",
  "how much space do i have": "df -h",
  "how much disk space is left": "df -h",
  "what's taking up space": "du -sh * | sort -h",
  "show folder sizes": "du -sh * | sort -h",
  "list files": "ls -la",
  "show hidden files": "ls -la",
  "what's my ip": "hostname -I",
  "check my ip address": "hostname -I",
  "how much memory is free": "free -h",
  "show running processes": "ps aux",
  "find a process by name": "pgrep -a <program name>",
  "kill a process": "kill <process id>",
  "stop a program by name": "pkill <program name>",
  "search for a file": "find . -iname <file name>",
  "find big files": "find . -type f -size +100M",
  "search inside files": "grep -rn <text> .",
  "show current directory": "pwd",
  "where am i": "pwd",
  "go to my home folder": "cd ~",
  "go up a folder": "cd ..",
  "go to a folder": "cd <folder>",
  "make a new folder": "mkdir -p <folder name>",
  "create an empty file": "touch <file name>",
  "delete a file": "rm <file>",
  "delete a folder": "rm -r <folder>",
  "copy a file": "cp <file> <destination>",
  "copy a folder": "cp -r <folder> <destination>",
  "move a file": "mv <file> <destination>",
  "rename a file": "mv <old name> <new name>",
  "show file contents": "cat <file>",
  "read a long file": "less <file>",
  "show first lines of a file": "head -n 20 <file>",
  "show last lines of a file": "tail -n 20 <file>",
  "watch a log file": "tail -f <file>",
  "count lines in a file": "wc -l <file>",
  "compare two files": "diff <first file> <second file>",
  "what's using my cpu": "top",
  "show network connections": "ss -tuln",
  "compress a folder": "tar -czvf <archive name>.tar.gz <folder>",
  "extract a tar file": "tar -xzvf <archive>",
  "check my linux version": "cat /etc/os-release",
  "show system info": "uname -a",
  "how long has this been running": "uptime",
  "show logged in users": "who",
  "who am i": "whoami",
  "show date and time": "date",
  "clear the screen": "clear",
  "make a script executable": "chmod +x <file>",
  "change file permissions": "chmod <mode> <file>",
  "change file owner": "sudo chown <user> <file>",
  "download a file": "wget <url>",
  "check internet connection": "ping -c 4 google.com",
  "where is a program installed": "command -v <program name>",
  "show my path": "echo $PATH",
  "how big is a folder": "du -sh <folder>",
  "show the biggest folders here": "du -sh * | sort -rh | head -n 10",
  "show disk partitions": "lsblk",
  "show cpu info": "lscpu",
  "how many cpu cores do i have": "nproc",
  "show memory usage": "free -h",
  "list usb devices": "lsusb",
  "show my graphics card": "lspci | grep -iE 'vga|3d|display'",
  "show open ports": "ss -tuln",
  "what's my public ip": "curl -s ifconfig.me",
  "check if a website is up": "curl -sI <url>",
  "show my username": "whoami",
  "show my groups": "groups",
  "show my shell": "echo $SHELL",
  "show environment variables": "env",
  "go back to the previous folder": "cd -",
  "count files in this folder": "ls -1 | wc -l",
  "show newest files": "ls -lt | head -n 15",
  "show file details": "stat <file>",
  "what type of file is this": "file <file>",
  "find text in a file": "grep -n <text> <file>",
  "sort a file": "sort <file>",
  "remove duplicate lines": "sort -u <file>",
  "create a shortcut to a file": "ln -s <target> <shortcut name>",
  "zip a folder": "zip -r <archive name>.zip <folder>",
  "unzip a file": "unzip <file>",
  "open a file": "xdg-open <file>",
  "show running services": "systemctl list-units --type=service --state=running",
  "show recent system logs": "journalctl -n 50 --no-pager",
  "show folder tree": "find . -maxdepth 2 -not -path '*/.*'",
  "go back": "cd -",
  "show git status": "git status",
  "what did i change": "git diff",
  "show staged changes": "git diff --staged",
  "which branch am i on": "git branch --show-current",
  "list local branches": "git branch",
  "show recent commits": "git log --oneline -n 10",
  "show the last commit": "git show HEAD",
  "stage a file": "git add <file>",
  "save my work": "git add -A && git commit -m <message>",
  "create a git branch": "git switch -c <branch>",
  "switch git branch": "git switch <branch>",
  "stash my changes": "git stash push -m <message>",
  "list saved stashes": "git stash list",
  "restore my stashed work": "git stash pop",
  "undo my last commit": "git reset --soft HEAD~1"
}
